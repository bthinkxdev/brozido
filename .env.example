
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to POST cross-origin (scheme required), e.g.
# when the storefront is embedded or fronted by a different domain in staging.
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL). Falls back to a local sqlite3 file if unset.
DATABASE_URL=postgres://brozido:brozido@localhost:5432/brozido
# Only used when DATABASE_URL is a real (non-sqlite) DB — connection pooling/timeouts.
DB_CONN_MAX_AGE=600
DB_CONNECT_TIMEOUT=10
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS S3 (optional media/static storage — leave USE_S3=False to use local disk)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-south-1
AWS_S3_CUSTOM_DOMAIN=


EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=brozido@gmail.com
EMAIL_TIMEOUT=15
# Dev-only override (brozido/settings/dev.py) — set to
# django.core.mail.backends.console.EmailBackend to print emails to the
# terminal instead of sending real SMTP while developing locally.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Store info (shown in storefront footer / Contact Us / structured data).
# STORE_ADDRESS is multi-line — easier to edit its default directly in
# brozido/settings/base.py than to escape newlines here.
# STORE_ADDRESS=
# STORE_PHONE=9744015184

# Brand (defaults live in brozido/settings/base.py; override only if needed)
# BRAND_NAME=BROZIDO
# BRAND_DOMAIN=www.brozido.com
# BRAND_PHONE=9744015184
# BRAND_WHATSAPP=919744015184
# BRAND_CUSTOMER_EMAIL=Ajaysreekrishnapuram123@gmail.com
# BRAND_SUPPORT_EMAIL=brozido@gmail.com
# ORDER_NUMBER_PREFIX=BRZ

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX); leave empty to disable
GOOGLE_ANALYTICS_ID=

# Google OAuth (storefront "Sign in with Google")
GOOGLE_CLIENT_ID=

# Accounts OTP
ACCOUNTS_OTP_EXPIRY_SECONDS=300
ACCOUNTS_OTP_MAX_ATTEMPTS=5
ACCOUNTS_GUEST_TOKEN_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Shipping / Payment credentials
#
# These are DEV-ONLY FALLBACKS. In every deployed environment, credentials are
# meant to be entered on Dashboard -> Settings (stored on the SiteSettings
# singleton) instead — that DB value always wins over the env var below when
# both are set. See shipping/shiprocket_client.py:get_shiprocket_config() and
# payments/adapters/concrete.py:_get_razorpay_credentials/_get_payu_credentials.
# ---------------------------------------------------------------------------

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# Must exactly match a pickup address "nickname" in your Shiprocket dashboard
# (Settings > Company Setup > Pick Up Address), not the address itself.
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=
# Secret Shiprocket sends back on status webhooks (X-Api-Key header or ?token=) —
# must match what's configured in the Shiprocket dashboard's webhook settings.
SHIPROCKET_WEBHOOK_TOKEN=

# Razorpay (RZP_CLIENT_ID/RZP_CLIENT_SECRET are also accepted, checked first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Deployment-only — always read from env (never from SiteSettings), used to
# verify the X-Razorpay-Signature header on the real server-to-server webhook
# (payments.views.razorpay_webhook_view), separate from the key/secret above.
RAZORPAY_WEBHOOK_SECRET=

# PayU
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# true = hits PayU's test/sandbox endpoint (test.payu.in); false = live (secure.payu.in).
# Also toggleable from Dashboard -> Settings once credentials are configured there.
PAYU_TEST_MODE=true

# ---------------------------------------------------------------------------
# Production only (brozido/settings/prod.py / staging.py)
# ---------------------------------------------------------------------------

# Sentry error tracking — leave SENTRY_DSN blank to disable entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# HTTPS enforcement — safe to leave at the defaults behind the nginx config in
# deploy/nginx/brozido.conf, which already terminates TLS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Gunicorn (deploy/gunicorn/gunicorn.conf.py) — read directly from the OS
# environment, not via django-environ, but sourced from this same .env file
# via EnvironmentFile= in deploy/systemd/brozido.service. Defaults shown
# are what gunicorn.conf.py falls back to when unset; usually fine as-is.
# GUNICORN_BIND=unix:/run/brozido/gunicorn.sock
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
# GUNICORN_ACCESS_LOG=-
# GUNICORN_ERROR_LOG=-
# GUNICORN_LOG_LEVEL=info
