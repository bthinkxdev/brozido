[Unit]
Description=brozido Gunicorn daemon
After=network.target

[Service]
User=www-data
Group=www-data
RuntimeDirectory=brozido
RuntimeDirectoryMode=0755
WorkingDirectory=/var/www/brozido
EnvironmentFile=/var/www/brozido/.env
Environment=DJANGO_SETTINGS_MODULE=brozido.settings.prod
ExecStart=/var/www/brozido/.venv/bin/gunicorn \
    -c deploy/gunicorn/gunicorn.conf.py \
    brozido.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
